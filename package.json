{
  "name": "neezy-studio",
  "version": "0.1.0",
  "description": "本地 AI 桌面 Agent — pi-coding-agent 轻壳",
  "author": "Neezy Studio",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-dev-ports.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack:win": "electron-vite build && electron-builder --win --publish never",
    "pack:win:dir": "electron-vite build && electron-builder --win dir --publish never",
    "pack:unpack": "electron-vite build && electron-builder --win dir --x64 --publish never",
    "start": "electron-vite preview",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check --write",
    "knip": "knip",
    "knip:fix": "knip --fix --fix-type exports,types,dependencies",
    "knip:clean": "knip --fix --fix-type exports,types,dependencies,files --allow-remove-files"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "jsonc-parser": "^3.3.1",
    "pi-mcp-adapter": "^3.2.0",
    "pi-permission-system": "^0.8.0",
    "pi-web-access": "^0.10.7",
    "typebox": "^1.1.38"
  },
  "build": {
    "appId": "com.neezy.studio",
    "productName": "Neezy",
    "afterPack": "./scripts/sign-win-exe.mjs",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "out/**",
      "package.json",
      "node_modules/**",
      "!**/*.map",
      "!**/*.{darwin,linux}-*.node",
      "!node_modules/@mariozechner/clipboard-{darwin,linux,win32-arm64}-*/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/sora": "^5.2.8",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.11",
    "@tiptap/extension-image": "^3.25.0",
    "@tiptap/extension-link": "^3.25.0",
    "@tiptap/extension-placeholder": "^3.25.0",
    "@tiptap/html": "^3.25.0",
    "@tiptap/pm": "^3.25.0",
    "@tiptap/react": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-log": "^5.4.4",
    "electron-vite": "6.0.0-beta.0",
    "framer-motion": "^13.4.4",
    "knip": "^6.14.2",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.11",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router": "7.15.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.13",
    "vite-plugin-svgr": "^5.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  }
}
